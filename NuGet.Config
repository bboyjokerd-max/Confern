<?xml version="1.0" encoding="utf-8"?>
<!--
  為什麼這個檔案存在（2026-10-07）：
  本機 `%APPDATA%\NuGet\NuGet.Config` 的 <packageSources> 是**空標籤**，所以
  `dotnet nuget list source` 回「找不到任何來源」——一旦有了 PackageReference，
  不先補來源就**無法還原、無法建置**。這裡把來源寫在 **repo 內**，
  而不是去改使用者或機器的設定：影響範圍僅限這個 repo，而且它跟著版控走。

  <clear /> 是刻意的：不讓機器上任何殘留來源影響這個專案的還原結果。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>