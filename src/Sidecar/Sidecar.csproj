<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>Sidecar</AssemblyName>
    <RootNamespace>Sidecar</RootNamespace>
    <StartupObject>Sidecar.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
    <!-- 預設會把 git revision 併成 0.1.0+<sha>；對外顯示版本不要夾帶 commit -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!--
      M1b 只用 GDI+（System.Drawing）把輪盤畫進 32bpp ARGB 點陣圖，再交給 UpdateLayeredWindow。
      為什麼不是 System.Drawing.Common 的 PackageReference：本機沒有 NuGet 全域快取，
      新增套件會讓離線建置失敗；Microsoft.WindowsDesktop.App.Ref 目標套件已在本機，
      UseWindowsForms 可離線解析（tools/dragsim 已在用）。本專案**不使用任何 WinForms 型別**，
      也不呼叫 ApplicationConfiguration.Initialize()（DPI 感知由 app.manifest 的 PerMonitorV2 決定）。
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      M1c 的編解碼層（規格 §6.1／§6.2 兩張表都寫「自建（WIC）」）用 System.Windows.Media.Imaging，
      也就是 WPF 對 WIC 的包裝。為什麼非 WIC 不可：**GDI+ 用不到 WIC 編解碼器**，而系統的 HEIF
      擴充註冊的是 WIC codec，所以 HEIC 輸入只有走 WIC 才可能成立。
      這不推翻 D10：D10 否決 WPF 的理由是「輪盤需要自己的 Dispatcher 幫浦對抗現有 GetMessage 迴圈」，
      輪盤仍然由 GDI+ 繪製；WIC 影像 API 不需要 Dispatcher（跨執行緒一律 Freeze()）。
      同樣不新增任何 PackageReference：UseWPF 由本機的 Microsoft.WindowsDesktop.App.Ref 解析。
    -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!--
      實測：一旦 UseWPF=true，SDK 提供的隱式 using 集合就換成 WPF 那一套，**System.IO 會消失**
      （Evidence.cs 立刻以 CS0246 StreamWriter 失敗）。補回來而不是逐檔加 using——
      這樣「原本能編譯的檔案」不會因為換 SDK 模式而需要零星修改。
    -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
